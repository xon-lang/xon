{
  "author": "Nizami",
  "dependencies": {
    "antlr4": "^4.13.2"
  },
  "devDependencies": {
    "@microsoft/api-extractor": "^7.55.2",
    "@types/node": "25.0.3",
    "@types/vscode": "1.107.0",
    "barrelize": "^1.7.2",
    "typescript": "5.9.3",
    "unplugin-dts": "^1.0.0-beta.6",
    "vite": "7.3.1",
    "vite-tsconfig-paths": "^6.0.3",
    "vitest": "4.0.16"
  },
  "name": "xon",
  "scripts": {
    "barrelize": "barrelize",
    "build": "npm run build:core && npm run build:analyzer && npm run build:translator",
    "build:analyzer": "cd packages/analyzer && vite build",
    "build:core": "cd packages/core && vite build",
    "build:translator": "cd packages/translator && vite build",
    "build:vscode": "cd packages/vscode && vite build",
    "dev": "npm run barrelize && tsc --noEmit --watch",
    "grammar": "tsc -p scripts/tsconfig.json && node scripts/dist/grammar.script.js",
    "grammar:json": "java -jar ./scripts/antlr/antlr-4.13.2-complete.jar -Dlanguage=TypeScript packages/grammar/src/language/json/JsonGrammar.g4",
    "test": "vitest run"
  },
  "type": "module"
}
