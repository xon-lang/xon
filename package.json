{
  "author": "Nizami",
  "dependencies": {
    "antlr4": "^4.13.2"
  },
  "devDependencies": {
    "@microsoft/api-extractor": "^7.53.3",
    "@types/node": "24.10.0",
    "@types/vscode": "1.105.0",
    "barrelize": "^1.6.6",
    "typescript": "5.9.3",
    "unplugin-dts": "^1.0.0-beta.6",
    "vite": "7.1.12",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "4.0.6"
  },
  "name": "xon",
  "scripts": {
    "analyzer:build": "cd packages/analyzer && vite build",
    "barrelize": "barrelize",
    "build": "npm run core:build && npm run analyzer:build && npm run translator:build",
    "core:build": "cd packages/core && vite build",
    "dev": "npm run barrelize && tsc --noEmit --watch",
    "grammar": "tsc -p scripts/tsconfig.json && node scripts/dist/grammar.script.js",
    "grammar:json": "java -jar ./scripts/antlr/antlr-4.13.2-complete.jar -Dlanguage=TypeScript packages/grammar/src/language/json/JsonGrammar.g4",
    "test": "vitest run",
    "translator:build": "cd packages/translator && vite build",
    "vscode:build": "cd packages/vscode && vite build"
  },
  "type": "module"
}
